# Rust build output and diagnostics (keep Cargo.lock for reproducible CLI builds)
/debug/
/target/
**/*.rs.bk
*.pdb
**/mutants.out*/
rustc-ice-*.txt

# Python release tooling bytecode
__pycache__/
*.py[cod]

# Downloaded assets, generated tooling, and ad hoc exports
/.imposter-cache/
/test/tooling/
/test/inspection.txt
/dist/
/output/
.imposter-baker-*/

# Wally dependencies and default package exports
/Packages/
/ServerPackages/
/imposter-render/Packages/
/imposter-render/ServerPackages/
/imposter-render/wally.lock
/imposter-render.zip
/imposter-render.rbxm
/imposter-render/imposter-render.zip
/imposter-render/imposter-render.rbxm

# Generated Rojo sourcemaps and Roblox Studio locks
/sourcemap.json
/imposter-render/sourcemap.json
*.rbxl.lock
*.rbxlx.lock
*.rbxm.lock
*.rbxmx.lock

# Local environment files; example configuration can be committed
.env
.env.*
!.env.example
!.env.sample

# Local editor and operating-system metadata
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini

# test/*.rbxm and test/demo/ are intentional fixtures and reference outputs.
